            "id": "shared-card",
            "eventId": "other-card",
            "owner": "other",
            "title": "Other title",
            "rank": "b"
          }
        ],
        "boards": []
      }
    },
    {
      "name": "multi-author-board",
      "description": "Two identities write the same board id; the newer event wins and columns are not duplicated.",
      "events": [
        {
          "id": "owner-board",
          "kind": 30623,
          "pubkey": "owner",
          "created_at": 10,
          "tags": [["d", "shared-board"]],
          "content": {
            "title": "Owner board",
            "lists": [{ "id": "a", "title": "A", "rank": "a" }]
          }
        },
        {
          "id": "other-board",
          "kind": 30623,
          "pubkey": "other",
          "created_at": 20,
          "tags": [["d", "shared-board"]],
          "content": {
            "title": "Other board",
            "lists": [
              { "id": "a", "title": "A", "rank": "a" },
              { "id": "b", "title": "B", "rank": "c" }
            ]
          }
        }
      ],
      "expected": {
        "cards": [],
        "boards": [
          {
            "id": "shared-board",
            "eventId": "other-board",
            "owner": "other",
            "title": "Other board",
            "listCount": 2
          }
        ]
      }
    },
