  "scenarios": [
    {
      "name": "multi-author-card",
      "description": "Two identities write the same card id; the newer event wins and only one card remains.",
      "events": [
        {
          "id": "owner-card",
          "kind": 30624,
          "pubkey": "owner",
          "created_at": 10,
          "tags": [
            ["d", "shared-card"],
            ["a", "30623:owner:operations"],
            ["l", "backlog"],
            ["t", "brand:HVG"],
            ["t", "fn:build"],
            ["rank", "a"]
          ],
          "content": {
            "title": "Owner title",
            "description": "Owner description",
            "assignees": [],
            "executionState": "idle",
            "createdBy": "owner",
            "comments": []
          }
        },
        {
          "id": "other-card",
          "kind": 30624,
          "pubkey": "other",
          "created_at": 20,
          "tags": [
            ["d", "shared-card"],
            ["a", "30623:owner:operations"],
            ["l", "backlog"],
            ["t", "brand:HVG"],
            ["t", "fn:build"],
            ["rank", "b"]
          ],
          "content": {
            "title": "Other title",
            "description": "Other description",
            "assignees": [],
            "executionState": "idle",
            "createdBy": "other",
            "comments": []
          }
        }
      ],
      "expected": {
        "cards": [
